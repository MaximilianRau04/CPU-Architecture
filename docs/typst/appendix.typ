== ALU Operations

#table(
  columns: (auto, auto, 1fr),
  fill: (x, y) => if (calc.rem(y, 2) == 0 and y != 0) { rgb("eee") },
  table.header("Operation", "Name", "Description"),
  `ALU_ADD`, "Add", "A + B",
  `ALU_ADDCY`, "Add with Carry", "A + B + Carry",
  `ALU_SUB`, "Subtract", "A - B",
  `ALU_SUBCY`, "Subtract with Carry", "A - B - Carry",
  `ALU_AND`, "Bitwise AND", "A AND B",
  `ALU_OR`, "Bitwise OR", "A OR B",
  `ALU_XOR`, "Bitwise XOR", "A XOR B",
  `ALU_RL`, "Rotate Left", "Rotate A left by 1 bit",
  `ALU_RR`, "Rotate Right", "Rotate A right by 1 bit",
  `ALU_SL0`, "Shift Left (insert 0)", "Shift A left, insert 0",
  `ALU_SL1`, "Shift Left (insert 1)", "Shift A left, insert 1",
  `ALU_SLA`, "Shift Left Arithmetic", "Shift A left, insert carry",
  `ALU_SLX`, "Shift Left Extended", "Shift A left, insert LSB",
  `ALU_SR0`, "Shift Right (insert 0)", "Shift A right, insert 0",
  `ALU_SR1`, "Shift Right (insert 1)", "Shift A right, insert 1",
  `ALU_SRA`, "Shift Right Arithmetic", "Shift A right, insert carry",
  `ALU_SRX`, "Shift Right Extended", "Shift A right, insert MSB (sign extension)",
  `ALU_TEST`, "Test", "A AND B, carry = odd parity",
  `ALU_COMPARECY`, "Compare with Carry", "A - B - Carry (flags only)",
  `ALU_TESTCY`, "Test with Carry", "A AND B, chain carry and zero",
  `ALU_PASS_B`, "Pass B", "Output B unchanged",
  `ALU_NOP`, "No Operation", "Output zero",
)
